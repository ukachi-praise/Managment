rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth.uid == 'GOpbb9SsavhpATk1p0KNmPGGQ0S2';
    }

    // Admins can read the whole collection, users can read/write their own document
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;
      allow list, get: if isAdmin();
    }

    match /classrooms/{docId} {
      allow read, write: if isAdmin();
    }
    
    // Subjects collection only accessible by admins
    match /subjects/{subjectId} {
      allow read, write: if isAdmin();
    }
  }
}
