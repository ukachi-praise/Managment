/**
 * @fileoverview Firestore Security Rules for JustVision Kiddies School.
 *
 * This ruleset enforces a role-based access control model. Admins have broad
 * access, while Teachers have access limited to their assigned classroom.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
        // Safely get user data. Returns null if the document doesn't exist.
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      // An admin is either the hardcoded super-admin UID or a user whose document
      // in the /users collection has the role property set to 'Admin'.
      return request.auth.uid == 'GOpbb9SsavhpATk1p0KNmPGGQ0S2' || (isSignedIn() && getUserData().role == 'Admin');
    }

    function isTeacher() {
      return isSignedIn() && getUserData().role == 'Teacher';
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function teacherClassroomId() {
        // This function assumes the user is a teacher and the document exists.
        return getUserData().assignedClassroomId;
    }

    function isTeacherForClassroom(classroomId) {
        return isTeacher() && teacherClassroomId() == classroomId;
    }

    // --- Collection Rules ---

    // User profiles can be read or updated by the owner or an admin.
    // Only admins can list or delete users.
    match /users/{userId} {
      allow get, update: if isOwner(userId) || isAdmin();
      allow list, delete: if isAdmin();
      // Allow users to create their own profile, or admins to create any profile.
      allow create: if isOwner(userId) || isAdmin();
    }
    
    // This single rule covers all collections that should be exclusively managed by Admins.
    // It is much cleaner and less error-prone than individual rules for each.
    match /{collection}/{docId} where collection in ['classrooms', 'subjects', 'classroomSubjects', 'sessions', 'enrollments', 'students', 'nextTermInfo', 'resultTemplates', 'headTeacherRemarks', 'auditLogs', 'roles_admin'] {
      allow read, write: if isAdmin();
    }
    
    // Terms are nested under sessions and also managed by Admins.
    match /sessions/{sessionId}/terms/{termId} {
        allow read, write: if isAdmin();
    }
    
    // --- Teacher-Specific Rules ---

    // Results can be read by admins or the teacher of the class.
    // Writes are restricted to the assigned teacher.
    match /results/{resultId} {
      allow get: if isAdmin() || (isTeacher() && resource.data.classroomId == teacherClassroomId());
      // A teacher can only list results that match their assigned classroom ID.
      // This requires the client to include a `where('classroomId', '==', classroomId)` clause.
      allow list: if isAdmin() || (isTeacher() && request.query.where[0][2] == teacherClassroomId());
      // Only the assigned teacher can create or update results for their classroom.
      allow write: if isTeacher() && request.resource.data.classroomId == teacherClassroomId();
      allow delete: if isAdmin();
    }
    
    // Result summaries follow the same rules as results.
    // Requires classroomId to be denormalized on the record for teacher access.
    match /resultSummaries/{summaryId} {
        allow get: if isAdmin() || (isTeacher() && resource.data.classroomId == teacherClassroomId());
        allow list: if isAdmin() || (isTeacher() && request.query.where[0][2] == teacherClassroomId());
        allow write: if isTeacher() && request.resource.data.classroomId == teacherClassroomId();
        allow delete: if isAdmin();
    }

    // Soft skill results follow the same rules as results.
    // Requires classroomId to be denormalized on the record for teacher access.
    match /softSkillResults/{softSkillResultId} {
        allow get: if isAdmin() || (isTeacher() && resource.data.classroomId == teacherClassroomId());
        allow list: if isAdmin() || (isTeacher() && request.query.where[0][2] == teacherClassroomId());
        allow write: if isTeacher() && request.resource.data.classroomId == teacherClassroomId();
        allow delete: if isAdmin();
    }
  }
}
