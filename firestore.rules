
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Explicit collection-group access is required for real-time result
    // monitoring across students/{studentId}/results/{resultId}.
    match /{path=**}/results/{resultId} {
      allow read: if request.auth != null;
    }

    // Applies to every collection and document
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
