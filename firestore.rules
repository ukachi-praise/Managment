
/**
 * @fileoverview Firestore Security Rules for JustVision Kiddies School.
 *
 * This ruleset enforces a role-based access control model. Admins have broad
 * access, while Teachers have access limited to their assigned classroom.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      // Grant admin if the UID is the hardcoded admin UID OR if they have a role document.
      return request.auth.uid == 'GOpbb9SsavhpATk1p0KNmPGGQ0S2' || exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
    function isTeacher() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Teacher';
    }
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    function teacherClassroomId() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedClassroomId;
    }
    function isTeacherForClassroom(classroomId) {
        return isTeacher() && teacherClassroomId() == classroomId;
    }

    // Admin role mapping. Read-only for admins to check status.
    match /roles_admin/{userId} {
      allow get: if isAdmin();
      allow list, create, update, delete: if false; // Managed via backend functions
    }

    // User profiles
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId); // Users create their own profile on signup
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Core data managed by Admins
    match /{collection}/{docId} where collection in ['classrooms', 'subjects', 'classroomSubjects', 'sessions', 'nextTermInfo', 'resultTemplates', 'headTeacherRemarks', 'auditLogs'] {
      allow read, write: if isAdmin();
    }
    
    // Terms are nested under sessions
    match /sessions/{sessionId}/terms/{termId} {
        allow read, write: if isAdmin();
    }

    // Students can be managed by Admins
    match /students/{studentId} {
      allow read, write: if isAdmin();
    }

    // Enrollments can be managed by Admins
    match /enrollments/{enrollmentId} {
        allow read, write: if isAdmin();
    }
    
    // Results can be read by admins or the teacher of the class.
    // Writes are restricted to the assigned teacher.
    match /results/{resultId} {
      allow get: if isAdmin() || isTeacherForClassroom(resource.data.classroomId);
      // Teachers can list results for their own class
      allow list: if isAdmin() || (isTeacher() && request.query.where[0][2] == teacherClassroomId());
      allow write: if isTeacherForClassroom(request.resource.data.classroomId);
      allow delete: if isAdmin();
    }
    
    // Result summaries follow same rules as results
    match /resultSummaries/{summaryId} {
        allow get: if isAdmin() || isTeacherForClassroom(resource.data.classroomId);
        allow list: if isAdmin() || (isTeacher() && request.query.where[0][2] == teacherClassroomId());
        allow write: if isTeacherForClassroom(request.resource.data.classroomId);
        allow delete: if isAdmin();
    }

    // Soft skill results follow same rules as results
    match /softSkillResults/{softSkillResultId} {
        allow get: if isAdmin() || isTeacherForClassroom(resource.data.classroomId);
        allow list: if isAdmin() || (isTeacher() && request.query.where[0][2] == teacherClassroomId());
        allow write: if isTeacherForClassroom(request.resource.data.classroomId);
        allow delete: if isAdmin();
    }
  }
}

    