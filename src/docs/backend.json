
{
  "entities": {
    "User": {
      "title": "User",
      "type": "object",
      "description": "Represents a user in the system (SuperAdmin, Admin, or Teacher).",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the user." },
        "name": { "type": "string", "description": "User's full name." },
        "email": { "type": "string", "description": "User's email for login." },
        "role": { "type": "string", "enum": ["SuperAdmin", "Admin", "Teacher"], "description": "User's role in the system." },
        "assignedClassroomId": { "type": "string", "description": "For teachers, the ID of the classroom they are assigned to." },
        "phoneNumber": { "type": "string", "description": "User's contact phone number." }
      },
      "required": ["id", "name", "role", "email"]
    },
    "Classroom": {
      "title": "Classroom",
      "type": "object",
      "description": "Represents a classroom.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the classroom." },
        "name": { "type": "string", "description": "Name of the classroom." },
        "teacherId": { "type": "string", "description": "Reference to the assigned teacher." },
        "teacherName": { "type": "string", "description": "Denormalized name of the assigned teacher." },
        "fees": { "type": "number", "description": "The default term fees for this specific class." }
      },
      "required": ["id", "name"]
    },
    "TermPayment": {
      "title": "TermPayment",
      "type": "object",
      "description": "Tracks payments for a student in a specific term.",
      "properties": {
        "id": { "type": "string", "description": "ID format: studentId_sessionId_termId" },
        "studentId": { "type": "string" },
        "sessionId": { "type": "string" },
        "termId": { "type": "string" },
        "expectedAmount": { "type": "number" },
        "installments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "amount": { "type": "number" },
              "date": { "type": "string", "format": "date-time" },
              "note": { "type": "string" }
            }
          }
        },
        "totalPaid": { "type": "number" },
        "balance": { "type": "number" }
      },
      "required": ["studentId", "sessionId", "termId"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      { "path": "/users/{userId}", "definition": { "schema": { "$ref": "#/backend/entities/User" } } },
      { "path": "/classrooms/{classroomId}", "definition": { "schema": { "$ref": "#/backend/entities/Classroom" } } },
      { "path": "/termPayments/{paymentId}", "definition": { "schema": { "$ref": "#/backend/entities/TermPayment" } } }
    ]
  }
}
