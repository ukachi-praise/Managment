
{
  "entities": {
    "User": {
      "title": "User",
      "type": "object",
      "description": "Represents a user in the system (Admin or Teacher).",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the user." },
        "username": { "type": "string", "description": "User's username for login." },
        "role": { "type": "string", "enum": ["Admin", "Teacher"], "description": "User's role in the system." },
        "assignedClassroomId": { "type": "string", "description": "For teachers, the ID of the classroom they are assigned to." }
      },
      "required": ["id", "username", "role"]
    },
    "Classroom": {
      "title": "Classroom",
      "type": "object",
      "description": "Represents a classroom.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the classroom." },
        "name": { "type": "string", "description": "Name of the classroom (e.g., 'Creche', 'Primary 5')." },
        "teacherId": { "type": "string", "description": "Reference to the assigned teacher." }
      },
      "required": ["id", "name"]
    },
    "Subject": {
      "title": "Subject",
      "type": "object",
      "description": "Represents an academic subject.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the subject." },
        "name": { "type": "string", "description": "Name of the subject (e.g., 'Mathematics')." }
      },
      "required": ["id", "name"]
    },
    "ClassroomSubject": {
      "title": "ClassroomSubject",
      "type": "object",
      "description": "Represents the assignment of a subject to a classroom.",
      "properties": {
        "classroomId": { "type": "string" },
        "subjectId": { "type": "string" }
      },
      "required": ["classroomId", "subjectId"]
    },
    "Student": {
      "title": "Student",
      "type": "object",
      "description": "Represents a student.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the student." },
        "name": { "type": "string", "description": "Name of the student." },
        "isDeleted": {"type": "boolean", "description": "Flag for soft-deleting a student."}
      },
      "required": ["id", "name"]
    },
    "Enrollment": {
        "title": "Enrollment",
        "type": "object",
        "description": "Links a student to a classroom for a specific academic session.",
        "properties": {
            "studentId": { "type": "string" },
            "classroomId": { "type": "string" },
            "sessionId": { "type": "string" }
        },
        "required": ["studentId", "classroomId", "sessionId"]
    },
    "AcademicSession": {
        "title": "AcademicSession",
        "type": "object",
        "description": "Represents an academic session, e.g., 2025/2026.",
        "properties": {
            "id": { "type": "string" },
            "name": { "type": "string", "description": "Format: YYYY/YYYY" }
        },
        "required": ["id", "name"]
    },
    "Term": {
        "title": "Term",
        "type": "object",
        "description": "Represents a term within an academic session (1st, 2nd, 3rd).",
        "properties": {
            "id": { "type": "string" },
            "sessionId": { "type": "string" },
            "name": { "type": "string", "enum": ["1st", "2nd", "3rd"] }
        },
        "required": ["id", "sessionId", "name"]
    },
    "Result": {
      "title": "Result",
      "type": "object",
      "description": "Represents a student's academic scores for a specific subject in a term.",
      "properties": {
        "studentId": { "type": "string" },
        "subjectId": { "type": "string" },
        "termId": { "type": "string" },
        "sessionId": { "type": "string" },
        "classroomId": { "type": "string", "description": "Denormalized for security rules."},
        "ca1": { "type": "number" }, "ca2": { "type": "number" }, "ca3": { "type": "number" }, "exam": { "type": "number" },
        "total": { "type": "number" }, "grade": { "type": "string" }, "remark": { "type": "string" },
        "daysSchoolOpened": { "type": "number" },
        "daysAttended": { "type": "number" },
        "attendancePercentage": { "type": "number" }
      },
      "required": ["studentId", "subjectId", "termId", "sessionId", "classroomId"]
    },
    "SoftSkillResult": {
      "title": "SoftSkillResult",
      "type": "object",
      "description": "Represents a student's score for a specific soft skill.",
      "properties": {
          "studentId": { "type": "string" },
          "termId": { "type": "string" },
          "skillName": { "type": "string" },
          "score": { "type": "number" },
          "remark": { "type": "string" }
      },
      "required": ["studentId", "termId", "skillName", "score", "remark"]
    },
    "HeadTeacherRemark": {
        "title": "HeadTeacherRemark",
        "type": "object",
        "description": "A predefined remark that a Head Teacher can use.",
        "properties": {
            "id": { "type": "string" },
            "remark": { "type": "string" }
        },
        "required": ["id", "remark"]
    },
    "ResultSummary": {
        "title": "ResultSummary",
        "type": "object",
        "description": "Contains overall summary information for a student's term report.",
        "properties": {
            "studentId": { "type": "string" },
            "termId": { "type": "string" },
            "overallAverage": { "type": "number" },
            "overallGrade": { "type": "string" },
            "headTeacherRemark": { "type": "string" },
            "nextTermResumptionDate": { "type": "string", "format": "date" },
            "nextTermFees": { "type": "number" }
        },
        "required": ["studentId", "termId"]
    },
    "NextTermInfo": {
        "title": "NextTermInfo",
        "type": "object",
        "description": "Information about the next term for a specific class.",
        "properties": {
            "classroomId": { "type": "string" },
            "termId": { "type": "string" },
            "resumptionDate": { "type": "string", "format": "date" },
            "fees": { "type": "number" }
        },
        "required": ["classroomId", "termId", "resumptionDate", "fees"]
    },
    "ResultTemplate": {
      "title": "ResultTemplate",
      "type": "object",
      "description": "Represents a template for generating results.",
      "properties": {
        "id": { "type": "string" }, "name": { "type": "string" },
        "templateData": { "type": "string", "description": "JSON data representing the template structure." },
        "logoUrl": { "type": "string", "description": "URL to the logo image in cloud storage."}
      },
      "required": ["id", "name", "templateData"]
    },
    "AuditLog": {
        "title": "AuditLog",
        "type": "object",
        "description": "Logs changes made to important data like results.",
        "properties": {
            "timestamp": { "type": "string", "format": "date-time" },
            "userId": { "type": "string" },
            "action": { "type": "string" },
            "entity": { "type": "string" },
            "entityId": { "type": "string" },
            "oldValue": { "type": "object" },
            "newValue": { "type": "object" }
        },
        "required": ["timestamp", "userId", "action", "entity", "entityId"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      { "path": "/users/{userId}", "definition": { "schema": { "$ref": "#/backend/entities/User" } } },
      { "path": "/classrooms/{classroomId}", "definition": { "schema": { "$ref": "#/backend/entities/Classroom" } } },
      { "path": "/subjects/{subjectId}", "definition": { "schema": { "$ref": "#/backend/entities/Subject" } } },
      { "path": "/classroomSubjects/{classroomSubjectId}", "definition": { "schema": { "$ref": "#/backend/entities/ClassroomSubject" } } },
      { "path": "/students/{studentId}", "definition": { "schema": { "$ref": "#/backend/entities/Student" } } },
      { "path": "/enrollments/{enrollmentId}", "definition": { "schema": { "$ref": "#/backend/entities/Enrollment" } } },
      { "path": "/sessions/{sessionId}", "definition": { "schema": { "$ref": "#/backend/entities/AcademicSession" } } },
      { "path": "/sessions/{sessionId}/terms/{termId}", "definition": { "schema": { "$ref": "#/backend/entities/Term" } } },
      { "path": "/results/{resultId}", "definition": { "schema": { "$ref": "#/backend/entities/Result" } } },
      { "path": "/softSkillResults/{softSkillResultId}", "definition": { "schema": { "$ref": "#/backend/entities/SoftSkillResult" } } },
      { "path": "/headTeacherRemarks/{remarkId}", "definition": { "schema": { "$ref": "#/backend/entities/HeadTeacherRemark" } } },
      { "path": "/resultSummaries/{summaryId}", "definition": { "schema": { "$ref": "#/backend/entities/ResultSummary" } } },
      { "path": "/nextTermInfo/{infoId}", "definition": { "schema": { "$ref": "#/backend/entities/NextTermInfo" } } },
      { "path": "/resultTemplates/{templateId}", "definition": { "schema": { "$ref": "#/backend/entities/ResultTemplate" } } },
      { "path": "/auditLogs/{logId}", "definition": { "schema": { "$ref": "#/backend/entities/AuditLog" } } },
      { "path": "/roles_admin/{userId}", "definition": { "schema": { "$ref": "#/backend/entities/User" } } }
    ]
  }
}

    